<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.krevzone.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/macmini2_kancl/horrorweb/scripts/weekly.sh</string>
  </array>
  <!-- každé pondělí v 6:00; když Mac spí, spustí se po probuzení -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/macmini2_kancl/horrorweb/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/macmini2_kancl/horrorweb/logs/launchd.log</string>
</dict>
</plist>
